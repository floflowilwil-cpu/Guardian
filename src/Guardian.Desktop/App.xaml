<Application x:Class="Guardian.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Guardian.Desktop.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Les couleurs (Colors.Dark/Light.xaml) sont injectées au démarrage par ThemeService. -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Art.xaml"/>
                <ResourceDictionary Source="Themes/ScrollBars.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <infra:StateToBrushConverter x:Key="StateToBrush"/>
            <infra:NullToCollapsedConverter x:Key="NullToCollapsed"/>
            <infra:NullToVisibleConverter x:Key="NullToVisible"/>
            <infra:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
