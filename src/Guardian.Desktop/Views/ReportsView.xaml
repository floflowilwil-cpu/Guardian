<UserControl x:Class="Guardian.Desktop.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <StackPanel>

        <!-- En-tête : titre, dernière analyse + illustration -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="28" Foreground="#F472B6" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Historique et rapports'}" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding LastScanText}" FontSize="15"/>
                <TextBlock Text="{loc:Loc 'Suivez vos analyses, vos menaces et exportez un rapport.'}" Style="{StaticResource MutedText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Image Grid.Column="1" Source="/Assets/reports.png" Height="130" Margin="16,0,0,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
        </Grid>

        <!-- Barre d'outils : période + actions -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc 'Période'}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ListBox Style="{StaticResource PlainListBox}" SelectedIndex="{Binding PeriodIndex, Mode=TwoWay}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{loc:Loc '7 jours'}" Margin="0,0,6,0"/>
                    <ListBoxItem Content="{loc:Loc '30 jours'}" Margin="0,0,6,0"/>
                    <ListBoxItem Content="{loc:Loc 'Tout'}"/>
                </ListBox>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="White" Margin="0,0,8,0"/>
                        <TextBlock Text="{loc:Loc 'Exporter le rapport'}" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" Margin="8,0,0,0"
                        Content="{loc:Loc 'Effacer l\'historique'}"/>
            </StackPanel>
        </Grid>

        <!-- Statistiques de la période -->
        <UniformGrid Columns="4">
            <Border Style="{StaticResource Card}" Margin="0,0,6,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="22" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ScansCount}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Analyses effectuées'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding FilesScanned, StringFormat=N0}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Fichiers analysés'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="3,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ThreatsFound}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Menaces détectées'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding InQuarantine}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'En quarantaine'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Historique des analyses -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="10">
            <StackPanel>
                <TextBlock Text="{loc:Loc 'Historique des analyses'}" FontWeight="SemiBold" Margin="8,2,0,10"/>

                <Grid Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*" MinWidth="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc 'Date'}" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="1" Text="{loc:Loc 'Type'}" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="2" Text="{loc:Loc 'Durée'}" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="3" Text="{loc:Loc 'Fichiers'}" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="4" Text="{loc:Loc 'Menaces'}" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="5" Text="{loc:Loc 'Résultat'}" Style="{StaticResource MutedText}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding History}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*" MinWidth="90"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DateText}" FontSize="13"/>
                                    <TextBlock Grid.Column="1" Text="{Binding KindLabel}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="13"/>
                                    <TextBlock Grid.Column="3" Text="{Binding FilesText}" FontSize="13"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Threats}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding ThreatsTone, Converter={StaticResource StateToBrush}}"/>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,7,0"
                                                 Fill="{Binding Tone, Converter={StaticResource StateToBrush}}"/>
                                        <TextBlock Text="{Binding OutcomeLabel}" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- État vide : invite à lancer une première analyse -->
                <StackPanel HorizontalAlignment="Center" Margin="0,18,0,12"
                            Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="{loc:Loc 'Aucune analyse enregistrée sur cette période.'}" Style="{StaticResource MutedText}" FontSize="13" HorizontalAlignment="Center"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartScanCommand}" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Content="{loc:Loc 'Lancer une analyse'}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Menaces de la dernière analyse -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="10">
            <StackPanel>
                <TextBlock Text="{loc:Loc 'Menaces de la dernière analyse'}" FontWeight="SemiBold" Margin="8,2,0,8"/>
                <TextBlock Text="{loc:Loc 'Aucune menace à afficher.'}" Style="{StaticResource MutedText}" FontSize="13" Margin="8,4,0,6"
                           Visibility="{Binding HasThreats, Converter={StaticResource InverseBoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Threats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="8,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0"
                                             Fill="{Binding Risk, Converter={StaticResource StateToBrush}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding RiskLabel}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                   Foreground="{Binding Risk, Converter={StaticResource StateToBrush}}"/>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="13" TextWrapping="Wrap" Margin="2,12,0,0"/>
    </StackPanel>
</UserControl>
