<Window x:Class="Guardian.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Guardian.Desktop.ViewModels"
        xmlns:views="clr-namespace:Guardian.Desktop.Views"
        Title="Guardian" Width="1180" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><views:ScanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProtectionViewModel}"><views:ProtectionView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThreatsViewModel}"><views:ThreatsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}"><views:QuarantineView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssistantViewModel}"><views:AssistantView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barre de titre -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="GUARDIAN" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Réduire"/>
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="Agrandir"/>
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Fermer"/>
            </StackPanel>
        </Grid>

        <!-- Bandeau démo -->
        <Border Grid.Row="1" Background="{DynamicResource WarningBrush}" Padding="10,4"
                Visibility="{Binding IsDemo, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Mode démonstration : données fictives, aucune protection réelle." Foreground="Black"
                       FontSize="12" HorizontalAlignment="Center"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Barre latérale -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Border x:Name="Row" CornerRadius="8" Padding="12,10" Background="Transparent">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource Glyph}"
                                                   Width="24" Foreground="{DynamicResource MutedBrush}"/>
                                        <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="13"
                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Contenu -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Margin="28,22"/>
        </Grid>
    </Grid>
</Window>
