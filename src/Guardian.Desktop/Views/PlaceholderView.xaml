<UserControl x:Class="Guardian.Desktop.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>
        <Border Style="{StaticResource Card}">
            <TextBlock Text="{loc:Loc 'Cette page sera disponible dans une prochaine version.'}" Style="{StaticResource MutedText}" FontSize="13"/>
        </Border>
    </StackPanel>
</UserControl>
