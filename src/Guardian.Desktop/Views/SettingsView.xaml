<UserControl x:Class="Guardian.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Paramètres" Style="{StaticResource PageTitle}"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Thème de l'application" FontWeight="SemiBold"/>
                    <ListBox Style="{StaticResource PlainListBox}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" Margin="0,10,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem Content="Clair" Padding="18,6" Margin="0,0,8,0"/>
                        <ListBoxItem Content="Sombre" Padding="18,6" Margin="0,0,8,0"/>
                        <ListBoxItem Content="Automatique" Padding="18,6"/>
                    </ListBox>

                    <TextBlock Text="Langue" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language, Mode=TwoWay}" Width="220" HorizontalAlignment="Left"/>

                    <Grid Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Mode silencieux" FontSize="13"/>
                            <TextBlock Text="Réduit les notifications sans désactiver les protections." Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SilentMode, Mode=TwoWay}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Mode hors ligne" FontSize="13"/>
                            <TextBlock Text="Aucune donnée ne quitte l'appareil." Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OfflineMode, Mode=TwoWay}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="État des moteurs" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{Binding EnginesState, Converter={StaticResource StateToBrush}}"/>
                        <TextBlock Text="{Binding EnginesSummary}" FontSize="13"
                                   Foreground="{Binding EnginesState, Converter={StaticResource StateToBrush}}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Engines}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
