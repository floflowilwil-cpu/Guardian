{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "GuardianService": {
    "ServiceName": "GuardianService",
    "ShutdownTimeoutSeconds": 15,
    "HeartbeatIntervalSeconds": 5,
    "HeartbeatStaleThresholdSeconds": 20,
    "WatchdogCheckIntervalSeconds": 10,
    "WatchdogMaxRestartsInWindow": 3,
    "WatchdogRestartWindowMinutes": 10,
    "IntegrityCheckIntervalMinutes": 15,
    "RequireSignedBinaries": false,
    "IpcPipeName": "Guardian.Service.Ipc.v1",
    "IpcMaxConcurrentConnections": 8,
    "IpcReadTimeoutSeconds": 10,
    "IpcMaxMessageBytes": 262144,
    "IpcReplayWindowSeconds": 60,
    "AllowNonAdminInteractiveIpc": true,
    "RequiredComponents": [
      "Guardian.Service.Host",
      "Guardian.Service.Watchdog",
      "Guardian.Service.SelfIntegrity"
    ]
  }
}
