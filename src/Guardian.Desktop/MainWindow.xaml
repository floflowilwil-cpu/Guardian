<Window x:Class="Guardian.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Guardian.Desktop.ViewModels"
        xmlns:views="clr-namespace:Guardian.Desktop.Views"
        Title="GUARDIAN — Sécurité Windows" Width="1360" Height="850" MinWidth="1050" MinHeight="700"
        Title="GUARDIAN — Sécurité Windows" Width="1360" Height="850" MinWidth="1050" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><views:ScanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProtectionViewModel}"><views:ProtectionView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ThreatsViewModel}"><views:ThreatsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuarantineViewModel}"><views:QuarantineView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><views:NetworkView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AssistantViewModel}"><views:AssistantView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="42"/>
            <RowDefinition Height="42"/>
        </Grid.RowDefinitions>

        <!-- Barre de fenêtre -->
        <Grid Grid.Row="0" Background="#050D1C">
            <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE83D;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                <TextBlock Text="GUARDIAN" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="  •  Votre allié sécurité sur Windows" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0,0,0"/>
        <!-- Barre de fenêtre -->
        <Grid Grid.Row="0" Background="#050D1C">
            <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE83D;" Style="{StaticResource Glyph}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0"/>
                <TextBlock Text="GUARDIAN" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="  •  Votre allié sécurité sur Windows" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="Réduire"/>
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="OnMaximizeRestore" ToolTip="Agrandir"/>
                <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Fermer"/>
            </StackPanel>
        </Grid>

        <!-- Identité visuelle Guardian -->
        <Border Grid.Row="1" Background="#07162D" BorderBrush="#173B69" BorderThickness="0,0,0,1" Padding="26,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/shield.png" Width="84" Height="94" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="GUARDIAN" FontSize="32" FontWeight="Bold" Foreground="#EAF5FF"/>
                    <TextBlock Text="Détecter. Protéger. Réagir." FontSize="16" FontWeight="SemiBold" Foreground="#42D5FF" Margin="1,0,0,3"/>
                    <TextBlock Text="Une sécurité complète, intelligente et transparente." FontSize="12" Foreground="#A8C6E8"/>
                </StackPanel>
                <UniformGrid Grid.Column="2" Rows="1" VerticalAlignment="Center" MinWidth="390">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9CE;" Style="{StaticResource Glyph}" FontSize="23" Foreground="#39D8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="IA locale" FontSize="10" Foreground="#C6DDF5" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="23" Foreground="#39D8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Protection" FontSize="10" Foreground="#C6DDF5" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="23" Foreground="#39D8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sandbox" FontSize="10" Foreground="#C6DDF5" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="23" Foreground="#39D8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rapports" FontSize="10" Foreground="#C6DDF5" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="23" Foreground="#39D8FF" HorizontalAlignment="Center"/>
                        <TextBlock Text="Mises à jour" FontSize="10" Foreground="#C6DDF5" Margin="0,5,0,0"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation latérale -->
            <Border Grid.Column="0" Background="#07152B" BorderBrush="#1A3A62" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="17,18,12,12">
                        <TextBlock Text="ESPACE DE SÉCURITÉ" FontSize="9" FontWeight="Bold" Foreground="#5F8FB9"/>
                        <TextBlock Text="Navigation" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="Row" CornerRadius="8" Padding="12,10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource Glyph}"
                                                       Width="25" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#123B69"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="#39D8FF"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="#F2F8FF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="11" Background="#0D2442" CornerRadius="9">
                        <StackPanel>
                            <TextBlock Text="GUARDIAN" FontSize="10" FontWeight="Bold" Foreground="#58DFFF"/>
                            <TextBlock Text="Sécurité locale Windows" FontSize="9" Foreground="#88A9CC" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            <!-- Navigation latérale -->
            <Border Grid.Column="0" Background="#07152B" BorderBrush="#1A3A62" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="17,18,12,12">
                        <TextBlock Text="ESPACE DE SÉCURITÉ" FontSize="9" FontWeight="Bold" Foreground="#5F8FB9"/>
                        <TextBlock Text="Navigation" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="Row" CornerRadius="8" Padding="12,10" Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="Icon" Text="{Binding Glyph}" Style="{StaticResource Glyph}"
                                                       Width="25" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="12"
                                                       Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#123B69"/>
                                        <Setter TargetName="Icon" Property="Foreground" Value="#39D8FF"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="#F2F8FF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="11" Background="#0D2442" CornerRadius="9">
                        <StackPanel>
                            <TextBlock Text="GUARDIAN" FontSize="10" FontWeight="Bold" Foreground="#58DFFF"/>
                            <TextBlock Text="Sécurité locale Windows" FontSize="9" Foreground="#88A9CC" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Zone de page avec défilement propre -->
            <Border Grid.Column="1">
                <Border.Background>
                    <RadialGradientBrush Center="0.8,0.1" RadiusX="0.95" RadiusY="0.95">
                        <GradientStop Color="#2A1259C8" Offset="0"/>
                        <GradientStop Color="#001259C8" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,22,26,24">
                    <ContentControl Content="{Binding CurrentPage}"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barre de statut -->
        <Border Grid.Row="4" Background="#050D1C" BorderBrush="#173B69" BorderThickness="0,1,0,0" Padding="22,0">
            <Grid VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" Foreground="#39D8FF" Margin="0,0,8,0"/>
                    <TextBlock Text="Une protection complète" FontSize="10" Foreground="#BFD7F0"/>
                    <TextBlock Text="     ⚡     Des performances optimisées     🔒     Votre vie privée respectée" FontSize="10" Foreground="#BFD7F0"/>
                </StackPanel>
                <TextBlock Text="Compatible Windows 10 / 11" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#7FA6CC"/>
            </Grid>
        </Border>
    </Grid>
</Window>
