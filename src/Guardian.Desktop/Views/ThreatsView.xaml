<UserControl x:Class="Guardian.Desktop.Views.ThreatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="28" Foreground="#FBBF24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Loc 'Centre des menaces'}" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Trois indicateurs : pastille colorée, grand chiffre, libellé -->
        <UniformGrid Grid.Row="1" Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="16,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Background="#26F87171" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="22" Foreground="#F87171"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Blocked}" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc 'Menaces bloquées'}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="5,0" Padding="16,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Background="#26FB923C" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="22" Foreground="#FB923C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InQuarantine}" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc 'En quarantaine'}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0" Padding="16,14">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="12" Background="#2638BDF8" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="22" Foreground="#38BDF8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Events}" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc 'Événements'}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" MinWidth="240"/>
                <ColumnDefinition Width="1.85*"/>
            </Grid.ColumnDefinitions>

            <!-- Liste des menaces -->
            <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14" MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Loc 'Menaces détectées'}" FontWeight="SemiBold" Margin="2,0,0,10"/>
                    <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding Threats}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="2,0,12,0"
                                             Fill="{Binding Risk, Converter={StaticResource StateToBrush}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DetectedAt, StringFormat='dd/MM/yyyy HH:mm'}" Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Text="{loc:Loc 'Aucune menace à afficher.'}" Style="{StaticResource MutedText}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding Selected, Converter={StaticResource NullToVisible}}"/>
                </Grid>
            </Border>

            <!-- Détails de la menace sélectionnée -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" MinHeight="300">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:Loc 'Détails de la menace sélectionnée'}" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <StackPanel Grid.Row="1" Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/threat.png" Width="120" Height="108" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{loc:Loc 'Niveau de risque : '}" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Selected.Risk, Converter={StaticResource StateToBrush}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Selected.DetectedAt, StringFormat='Détecté le : dd/MM/yyyy - HH:mm'}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                            <TextBlock Text="{Binding Selected.Path}" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Selected.Behavior}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc 'Mettre en quarantaine'}" Command="{Binding QuarantineCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc 'Voir les détails'}" Command="{Binding ToggleDetailsCommand}" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- État vide : illustration + message -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Selected, Converter={StaticResource NullToVisible}}">
                        <Image Source="/Assets/threat.png" MaxWidth="190" MaxHeight="170" Opacity="0.9"
                               RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
                        <TextBlock Text="{loc:Loc 'Les détails d\'une menace apparaîtront ici.'}" Style="{StaticResource MutedText}" FontSize="13"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
