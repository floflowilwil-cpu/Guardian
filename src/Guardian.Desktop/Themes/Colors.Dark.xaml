<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#050B18" Offset="0"/>
        <GradientStop Color="#0A1B3D" Offset="0.55"/>
        <GradientStop Color="#071126" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SidebarBrush"    Color="#0A1630"/>
    <SolidColorBrush x:Key="CardBrush"       Color="#0E1F40"/>
    <SolidColorBrush x:Key="CardAltBrush"    Color="#122650"/>
    <SolidColorBrush x:Key="LineBrush"       Color="#1F3A6B"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="#1E90FF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A3A73"/>
    <SolidColorBrush x:Key="TextBrush"       Color="#EAF2FF"/>
    <SolidColorBrush x:Key="MutedBrush"      Color="#8FA8CE"/>
    <SolidColorBrush x:Key="SuccessBrush"    Color="#22C55E"/>
    <SolidColorBrush x:Key="WarningBrush"    Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="#EF4444"/>
    <SolidColorBrush x:Key="UnknownBrush"    Color="#7C8DAA"/>
</ResourceDictionary>
