<UserControl x:Class="Guardian.Desktop.Views.ThreatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="28" Foreground="#FBBF24" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Text="{loc:Loc 'Centre des menaces'}" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3">
            <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Blocked}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Menaces bloquées'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding InQuarantine}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'En quarantaine'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Events}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Événements'}" Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <TextBlock Grid.Row="2" Text="{loc:Loc 'Détails de la menace sélectionnée'}" FontWeight="SemiBold" Margin="0,22,0,10"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="6" Margin="0,0,10,0" VerticalAlignment="Top">
                <Grid>
                    <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Threats}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}" MaxHeight="260">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DetectedAt, StringFormat='dd/MM/yyyy HH:mm'}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Content="{StaticResource ThreatArt}" Width="84" Height="84"/>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selected.Name}" FontWeight="SemiBold" FontSize="15"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{loc:Loc 'Niveau de risque : '}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding RiskText}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding Selected.Risk, Converter={StaticResource StateToBrush}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Selected.DetectedAt, StringFormat='Détecté le : dd/MM/yyyy - HH:mm'}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,0">
                        <TextBlock Text="{Binding Selected.Path}" FontSize="12"/>
                        <TextBlock Text="{Binding Selected.Behavior}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc 'Mettre en quarantaine'}" Command="{Binding QuarantineCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc 'Voir les détails'}" Command="{Binding ToggleDetailsCommand}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top"
                    Visibility="{Binding Selected, Converter={StaticResource NullToVisible}}">
                <TextBlock Text="{loc:Loc 'Aucune menace à afficher.'}" Style="{StaticResource MutedText}" FontSize="13"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
