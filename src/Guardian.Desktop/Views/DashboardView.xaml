<UserControl x:Class="Guardian.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc 'Vue d\'ensemble'}" Style="{StaticResource PageTitle}"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Bouclier : la couleur suit l'état réel du service -->
            <Grid Width="190" Height="214" HorizontalAlignment="Center">
                <Image Source="/Assets/shield.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Healthy">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Grid Width="130" Height="146" HorizontalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Healthy">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                <Path Data="{StaticResource ShieldGeometry}" Stretch="Uniform"
                      Fill="{Binding State, Converter={StaticResource StateToBrush}}" Opacity="0.18"/>
                <Path Data="{StaticResource ShieldGeometry}" Stretch="Uniform" StrokeThickness="3"
                      Stroke="{Binding State, Converter={StaticResource StateToBrush}}">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6"
                                          Color="#1E90FF"/>
                    </Path.Effect>
                </Path>
                <Path Data="{StaticResource CheckGeometry}" Stretch="Uniform" Width="56" Height="44" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding State, Converter={StaticResource StateToBrush}}"
                      Margin="0,-6,0,0">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Healthy">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
                </Grid>
            </Grid>

            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,4,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartScanCommand}" MinWidth="190">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" Foreground="White" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{loc:Loc 'Analyse rapide'}" Foreground="White"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding StartFullScanCommand}" MinWidth="190" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="{loc:Loc 'Analyse complète'}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <UniformGrid Columns="3" Margin="0,28,0,0" MinWidth="620">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9CE;" Style="{StaticResource Glyph}" FontSize="22" Margin="0,0,12,0"
                                   Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc 'Moteur IA'}" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding AiText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"
                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="22" Margin="0,0,12,0"
                                   Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc 'Définitions'}" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding DefinitionsText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"
                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE83D;" Style="{StaticResource Glyph}" FontSize="22" Margin="0,0,12,0"
                                   Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc 'Protection'}" Style="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding RealtimeText}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0"
                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="{loc:Loc 'Activité récente'}" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"
                               Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
                    <TextBlock Text="{Binding Activity}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
