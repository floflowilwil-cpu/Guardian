<UserControl x:Class="Guardian.Desktop.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <UserControl.Resources>
        <Style x:Key="ChoiceCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="16">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,12">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="28" Foreground="#A78BFA" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Centre d\'analyse'}" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{loc:Loc 'Choisissez votre type d\'analyse'}" FontSize="15"/>
            </StackPanel>
            <Image Source="/Assets/magnifier.png" Width="120" Height="120" HorizontalAlignment="Right" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
        </Grid>

        <UniformGrid Columns="3">
            <Button Style="{StaticResource ChoiceCard}" Tag="{Binding IsQuick}" Margin="0,0,10,0"
                    Command="{Binding SelectKindCommand}" CommandParameter="Quick">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Analyse rapide'}" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Fichiers sensibles et zones critiques'}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ChoiceCard}" Tag="{Binding IsFull}" Margin="5,0"
                    Command="{Binding SelectKindCommand}" CommandParameter="Full">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE7F4;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Analyse complète'}" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Tout votre système'}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ChoiceCard}" Tag="{Binding IsCustom}" Margin="10,0,0,0"
                    Command="{Binding SelectKindCommand}" CommandParameter="Custom">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="28" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc 'Analyse personnalisée'}" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding CustomLabel}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc 'Démarrer l\'analyse'}" Command="{Binding StartCommand}" MinWidth="200"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc 'Annuler'}" Command="{Binding CancelCommand}" Margin="10,0,0,0"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="0,22,0,0"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Grid>
                    <TextBlock Text="{Binding RunningLabel}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Percent, StringFormat={}{0} %}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Style="{StaticResource GlowProgress}" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,10"/>
                <TextBlock Text="{Binding Details}" FontSize="13" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,14,0,0"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</UserControl>
