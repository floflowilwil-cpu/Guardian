<UserControl x:Class="Guardian.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Vue d'ensemble" Style="{StaticResource PageTitle}"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Bouclier : la couleur suit l'état réel du service -->
            <Grid Width="130" Height="146" HorizontalAlignment="Center">
                <Path Data="{StaticResource ShieldGeometry}" Stretch="Uniform"
                      Fill="{Binding State, Converter={StaticResource StateToBrush}}" Opacity="0.18"/>
                <Path Data="{StaticResource ShieldGeometry}" Stretch="Uniform" StrokeThickness="3"
                      Stroke="{Binding State, Converter={StaticResource StateToBrush}}">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6"
                                          Color="#1E90FF"/>
                    </Path.Effect>
                </Path>
                <Path Data="{StaticResource CheckGeometry}" Stretch="Uniform" Width="56" Height="44" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding State, Converter={StaticResource StateToBrush}}"
                      Margin="0,-6,0,0">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Healthy">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>

            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,4,0,18"/>

            <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartScanCommand}"
                    HorizontalAlignment="Center" MinWidth="200">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" Foreground="White" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Lancer un scan" Foreground="White"/>
                </StackPanel>
            </Button>

            <UniformGrid Columns="3" Margin="0,28,0,0" MinWidth="620">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Moteur IA" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding AiText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Définitions" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding DefinitionsText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Protection" Style="{StaticResource MutedText}"/>
                        <TextBlock Text="{Binding RealtimeText}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Activité récente" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Activity}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
