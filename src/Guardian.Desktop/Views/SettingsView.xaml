<UserControl x:Class="Guardian.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400" MaxWidth="540"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,12,0">

            <!-- Titre avec l'icône Paramètres en bleu -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="28" Foreground="#38BDF8" Margin="0,0,12,0"/>
                <TextBlock Text="{loc:Loc 'Paramètres'}" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Apparence et comportement -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Apparence'}" FontSize="11" FontWeight="Bold" Foreground="#5F8FB9"/>

                    <TextBlock Text="{loc:Loc 'Thème de l\'application'}" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <ListBox Style="{StaticResource PlainListBox}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" Margin="0,10,0,0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBoxItem Content="{loc:Loc 'Clair'}" Padding="18,6" Margin="0,0,8,0"/>
                        <ListBoxItem Content="{loc:Loc 'Sombre'}" Padding="18,6" Margin="0,0,8,0"/>
                        <ListBoxItem Content="{loc:Loc 'Automatique'}" Padding="18,6"/>
                    </ListBox>

                    <TextBlock Text="{loc:Loc 'Langue'}" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <ComboBox Style="{StaticResource DarkCombo}" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding Language, Mode=TwoWay}" Width="220" HorizontalAlignment="Left"/>

                    <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,20,0,4" Opacity="0.7"/>

                    <TextBlock Text="{loc:Loc 'Confidentialité et notifications'}" FontSize="11" FontWeight="Bold" Foreground="#5F8FB9" Margin="0,14,0,0"/>

                    <!-- Texte à gauche (qui passe à la ligne), interrupteur à droite : plus de chevauchement -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{loc:Loc 'Mode silencieux'}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc 'Réduit les notifications sans désactiver les protections.'}"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SilentMode, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="{loc:Loc 'Mode hors ligne'}" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc 'Aucune donnée ne quitte l\'appareil.'}"
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding OfflineMode, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- État des moteurs -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="16" Foreground="#34D399" Margin="0,0,9,0"/>
                        <TextBlock Text="{loc:Loc 'État des moteurs'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0"
                                   Foreground="{Binding EnginesState, Converter={StaticResource StateToBrush}}"/>
                        <TextBlock Text="{Binding EnginesSummary}" FontSize="13"
                                   Foreground="{Binding EnginesState, Converter={StaticResource StateToBrush}}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Engines}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Robot Guardian et sa caisse à outils : grand, au centre de la zone de droite (ne défile pas) -->
        <Image Grid.Column="1" Source="/Assets/robot-tools.png" MaxWidth="560" MaxHeight="560"
               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0,0,0"
               RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
    </Grid>
</UserControl>
