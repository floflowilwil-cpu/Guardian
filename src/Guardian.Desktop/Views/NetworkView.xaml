<UserControl x:Class="Guardian.Desktop.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Guardian.Desktop.Infrastructure">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc 'Activité réseau'}" Style="{StaticResource PageTitle}"/>

        <!-- Carte stylisée des connexions -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Height="190">
            <Image Source="/Assets/map.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"/>
        </Border>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,14,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Connexions actives'}" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Active}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Connexions suspectes'}" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Suspicious}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{loc:Loc 'Principales destinations'}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="{loc:Loc 'Aucune donnée réseau disponible.'}" Style="{StaticResource MutedText}"
                           Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Destinations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Style="{StaticResource GlowProgress}" Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0}%}" HorizontalAlignment="Right"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
