<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4F8FF" Offset="0"/>
        <GradientStop Color="#E6EFFC" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SidebarBrush"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBrush"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardAltBrush"    Color="#EEF4FF"/>
    <SolidColorBrush x:Key="LineBrush"       Color="#CFDCF2"/>
    <SolidColorBrush x:Key="AccentBrush"     Color="#1273E6"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEAFF"/>
    <SolidColorBrush x:Key="TextBrush"       Color="#0E1F40"/>
    <SolidColorBrush x:Key="MutedBrush"      Color="#587099"/>
    <SolidColorBrush x:Key="SuccessBrush"    Color="#15A34A"/>
    <SolidColorBrush x:Key="WarningBrush"    Color="#D97706"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="#DC2626"/>
    <SolidColorBrush x:Key="UnknownBrush"    Color="#7C8DAA"/>
</ResourceDictionary>
