<UserControl x:Class="Guardian.Desktop.Views.QuarantineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Quarantaine" Style="{StaticResource PageTitle}" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
            <TextBlock Text="Les fichiers suspects sont isolés et sécurisés." Style="{StaticResource MutedText}" Margin="0,2,0,12"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="8,0,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="Nom" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="2" Text="Date" Style="{StaticResource MutedText}"/>
                    <TextBlock Grid.Column="3" Text="Risque" Style="{StaticResource MutedText}"/>
                </Grid>

                <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding Items}"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource RowCheck}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat='dd/MM/yyyy HH:mm'}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                             Fill="{Binding Risk, Converter={StaticResource StateToBrush}}"/>
                                    <TextBlock Text="{Binding RiskLabel}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,10,0,0">
                    <Button Style="{StaticResource PrimaryButton}" Content="Restaurer" Command="{Binding RestoreCommand}"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Supprimer" Command="{Binding DeleteCommand}" Margin="10,0,0,0"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Quarantaine sécurisée" FontWeight="SemiBold"/>
                    <TextBlock Text="Les fichiers isolés ne peuvent pas être exécutés." Style="{StaticResource MutedText}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
