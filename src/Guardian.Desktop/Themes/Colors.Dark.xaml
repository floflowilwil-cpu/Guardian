<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#050B18" Offset="0"/>
        <GradientStop Color="#081A35" Offset="0.52"/>
        <GradientStop Color="#061126" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBrush" Color="#07152B"/>
    <SolidColorBrush x:Key="CardBrush" Color="#0C1E39"/>
    <SolidColorBrush x:Key="CardAltBrush" Color="#10294B"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1B426D"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#12BFFF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#123B69"/>
    <SolidColorBrush x:Key="TextBrush" Color="#EDF6FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#91AFD1"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#24D99A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5368"/>
    <SolidColorBrush x:Key="UnknownBrush" Color="#7C91AE"/>
</ResourceDictionary>
