<UserControl x:Class="Guardian.Desktop.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Activité réseau" Style="{StaticResource PageTitle}"/>

        <!-- Zone carte : emplacement réservé, la carte des connexions viendra avec Guardian.Network -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Height="190">
            <Grid>
                <TextBlock Text="&#xE774;" Style="{StaticResource Glyph}" FontSize="96" Opacity="0.18"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Carte des connexions (bientôt disponible)" Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,14,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Connexions actives" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Active}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="Connexions suspectes" Style="{StaticResource MutedText}"/>
                    <TextBlock Text="{Binding Suspicious}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{DynamicResource DangerBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Principales destinations" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Text="Aucune donnée réseau disponible." Style="{StaticResource MutedText}"
                           Visibility="{Binding HasData, Converter={StaticResource InverseBoolToVisibility}}"/>
                <ItemsControl ItemsSource="{Binding Destinations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Style="{StaticResource GlowProgress}" Height="6" Minimum="0" Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}" Margin="10,0"/>
                                <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0}%}" HorizontalAlignment="Right"
                                           Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
