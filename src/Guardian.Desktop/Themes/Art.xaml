<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Illustrations vectorielles de la maquette (bouclier, robot, cadenas, loupe, carte du monde).
        x:Shared="False" : chaque utilisation crée sa propre instance.
        Utilisation :  <ContentControl Content="{StaticResource ShieldArt}" Width="170" Height="190"/>
    -->

    <Geometry x:Key="ArtShield">M 50,0 L 100,18 L 100,52 C 100,82 76,102 50,112 C 24,102 0,82 0,52 L 0,18 Z</Geometry>

    <!-- ================= BOUCLIER 3D ================= -->
    <Viewbox x:Key="ShieldArt" x:Shared="False" Stretch="Uniform">
        <Grid Width="200" Height="230">
            <!-- reflet au sol -->
            <Ellipse Width="190" Height="30" VerticalAlignment="Bottom" Margin="0,0,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#CC2FA8FF" Offset="0"/>
                        <GradientStop Color="#552FA8FF" Offset="0.5"/>
                        <GradientStop Color="#002FA8FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="130" Height="16" VerticalAlignment="Bottom" Margin="0,7,0,0"
                     Stroke="#8F4DC3FF" StrokeThickness="1.5"/>
            <!-- bouclier extérieur -->
            <Path Data="{StaticResource ArtShield}" Stretch="Uniform" Width="150" Height="170"
                  VerticalAlignment="Top" Margin="0,8,0,0" StrokeThickness="4" Stroke="#9BDCFF">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.2,0" EndPoint="0.8,1">
                        <GradientStop Color="#5CC2FF" Offset="0"/>
                        <GradientStop Color="#1A6BE8" Offset="0.55"/>
                        <GradientStop Color="#0B3FA8" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect Color="#1E90FF" BlurRadius="40" ShadowDepth="0" Opacity="0.85"/>
                </Path.Effect>
            </Path>
            <!-- bouclier intérieur -->
            <Path Data="{StaticResource ArtShield}" Stretch="Uniform" Width="118" Height="134"
                  VerticalAlignment="Top" Margin="0,27,0,0" StrokeThickness="1.5" Stroke="#6FCBFF">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0E3E96" Offset="0"/>
                        <GradientStop Color="#0A4FC4" Offset="0.6"/>
                        <GradientStop Color="#1E90FF" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <!-- reflet -->
            <Path Data="M 50,6 L 8,20 L 8,52 C 8,78 28,95 50,105 Z" Stretch="Uniform" Width="62" Height="120"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,22,0,0" IsHitTestVisible="False">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#40FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Grid>
    </Viewbox>

    <!-- ================= ROBOT IA (assistant) ================= -->
    <Viewbox x:Key="RobotArt" x:Shared="False" Stretch="Uniform">
        <Grid Width="170" Height="200">
            <Ellipse Width="150" Height="24" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#992FA8FF" Offset="0"/>
                        <GradientStop Color="#002FA8FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- corps -->
            <Border Width="120" Height="74" CornerRadius="38,38,14,14" VerticalAlignment="Bottom" Margin="0,0,0,10">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EAF3FF" Offset="0"/>
                        <GradientStop Color="#6F9AD6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Ellipse Width="18" Height="18" VerticalAlignment="Bottom" Margin="0,0,0,34" Fill="#1E90FF">
                <Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="14" ShadowDepth="0"/></Ellipse.Effect>
            </Ellipse>
            <!-- antenne -->
            <Rectangle Width="3" Height="20" Fill="#9FB9DD" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <Ellipse Width="11" Height="11" Fill="#4DC3FF" VerticalAlignment="Top" Margin="0,0,0,0">
                <Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
            </Ellipse>
            <!-- oreillettes -->
            <Border Width="16" Height="40" CornerRadius="8" Background="#1E90FF" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="14,62,0,0">
                <Border.Effect><DropShadowEffect Color="#1E90FF" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
            </Border>
            <Border Width="16" Height="40" CornerRadius="8" Background="#1E90FF" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,62,14,0">
                <Border.Effect><DropShadowEffect Color="#1E90FF" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
            </Border>
            <!-- tête -->
            <Border Width="112" Height="92" CornerRadius="42" VerticalAlignment="Top" Margin="0,24,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#9DBCE8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- visière -->
            <Border Width="90" Height="54" CornerRadius="26" VerticalAlignment="Top" Margin="0,43,0,0"
                    Background="#0A1430" BorderBrush="#1E90FF" BorderThickness="1.5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="14" Height="16" Fill="#5DDCFF" Margin="0,0,16,0">
                        <Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Width="14" Height="16" Fill="#5DDCFF">
                        <Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                </StackPanel>
            </Border>
            <!-- micro -->
            <Path Data="M 0,0 C 0,26 14,34 32,34" Stroke="#1E90FF" StrokeThickness="3" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,96,0,0"/>
        </Grid>
    </Viewbox>

    <!-- ================= CADENAS (quarantaine) ================= -->
    <Viewbox x:Key="LockArt" x:Shared="False" Stretch="Uniform">
        <Grid Width="130" Height="150">
            <Ellipse Width="120" Height="20" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#992FA8FF" Offset="0"/>
                        <GradientStop Color="#002FA8FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Data="M 0,50 L 0,32 A 28,28 0 0 1 56,32 L 56,50" Stroke="#9BDCFF" StrokeThickness="12"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center"
                  VerticalAlignment="Top" Margin="0,8,0,0" Width="56" Height="64" Stretch="None">
                <Path.Effect><DropShadowEffect Color="#1E90FF" BlurRadius="18" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
            </Path>
            <Border Width="96" Height="78" CornerRadius="12" VerticalAlignment="Bottom" Margin="0,0,0,12"
                    BorderBrush="#9BDCFF" BorderThickness="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#3FA9FF" Offset="0"/>
                        <GradientStop Color="#0B52D2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect><DropShadowEffect Color="#1E90FF" BlurRadius="26" ShadowDepth="0" Opacity="0.7"/></Border.Effect>
                <Grid>
                    <Ellipse Width="16" Height="16" Fill="#07163A" VerticalAlignment="Center" Margin="0,-8,0,0"/>
                    <Rectangle Width="6" Height="22" Fill="#07163A" RadiusX="3" RadiusY="3" VerticalAlignment="Center" Margin="0,22,0,0"/>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>

    <!-- ================= MENACE (cheval de Troie, rouge) ================= -->
    <Viewbox x:Key="ThreatArt" x:Shared="False" Stretch="Uniform">
        <Grid Width="120" Height="130">
            <Ellipse Width="110" Height="130" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#55EF4444" Offset="0"/>
                        <GradientStop Color="#00EF4444" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Rectangle Width="3" Height="16" Fill="#FF8A8A" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <Ellipse Width="10" Height="10" Fill="#FF4D4D" VerticalAlignment="Top">
                <Ellipse.Effect><DropShadowEffect Color="#FF3B3B" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
            </Ellipse>
            <Border Width="104" Height="38" CornerRadius="18,18,6,6" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#C42B2B" Offset="0"/>
                        <GradientStop Color="#5A0E16" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Width="82" Height="68" CornerRadius="30" VerticalAlignment="Top" Margin="0,22,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF6464" Offset="0"/>
                        <GradientStop Color="#A31828" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect><DropShadowEffect Color="#EF4444" BlurRadius="24" ShadowDepth="0" Opacity="0.8"/></Border.Effect>
                <Grid>
                    <Border Width="58" Height="26" CornerRadius="13" Background="#1A0A12" VerticalAlignment="Top" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="#FFD84D" Margin="0,0,12,0"/>
                            <Ellipse Width="10" Height="10" Fill="#FFD84D"/>
                        </StackPanel>
                    </Border>
                    <Rectangle Width="26" Height="4" Fill="#1A0A12" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" Margin="0,0,0,9"/>
                </Grid>
            </Border>
        </Grid>
    </Viewbox>

    <!-- ================= LOUPE (centre d'analyse) ================= -->
    <Viewbox x:Key="MagnifierArt" x:Shared="False" Stretch="Uniform">
        <Grid Width="110" Height="110">
            <Ellipse Width="104" Height="104" Stroke="#334DC3FF" StrokeThickness="1" StrokeDashArray="2 4"/>
            <Ellipse Width="80" Height="80" Stroke="#554DC3FF" StrokeThickness="1" StrokeDashArray="3 3"/>
            <Ellipse Width="52" Height="52" StrokeThickness="5" Stroke="#6FD0FF" HorizontalAlignment="Left"
                     VerticalAlignment="Top" Margin="22,18,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#661E90FF" Offset="0"/>
                        <GradientStop Color="#111E90FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><DropShadowEffect Color="#1E90FF" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
            </Ellipse>
            <Line X1="64" Y1="66" X2="86" Y2="90" Stroke="#6FD0FF" StrokeThickness="8" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round">
                <Line.Effect><DropShadowEffect Color="#1E90FF" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/></Line.Effect>
            </Line>
        </Grid>
    </Viewbox>

    <!-- ================= CARTE DU MONDE (réseau) ================= -->
    <DrawingBrush x:Key="DotPatternBrush" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute"
                  Viewbox="0,0,3,3" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing Brush="#9937A5FF">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="1.5,1.5" RadiusX="0.7" RadiusY="0.7"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <Viewbox x:Key="WorldMapArt" x:Shared="False" Stretch="Uniform">
        <Canvas Width="200" Height="100">
            <Canvas.Background>
                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.9">
                    <GradientStop Color="#33105AB8" Offset="0"/>
                    <GradientStop Color="#00105AB8" Offset="1"/>
                </RadialGradientBrush>
            </Canvas.Background>
            <!-- continents, remplis de points -->
            <Path Fill="{StaticResource DotPatternBrush}" Data="M 18,14 L 40,10 L 58,14 L 62,26 L 54,36 L 46,44 L 40,52 L 32,46 L 24,38 L 16,30 Z"/>
            <Path Fill="{StaticResource DotPatternBrush}" Data="M 66,6 L 80,6 L 78,16 L 68,16 Z"/>
            <Path Fill="{StaticResource DotPatternBrush}" Data="M 46,54 L 58,54 L 66,64 L 62,80 L 54,94 L 48,84 L 46,68 Z"/>
            <Path Fill="{StaticResource DotPatternBrush}" Data="M 92,16 L 108,12 L 118,18 L 114,28 L 100,30 L 92,26 Z"/>
            <Path Fill="{StaticResource DotPatternBrush}" Data="M 92,34 L 112,32 L 122,42 L 118,60 L 108,78 L 98,72 L 94,54 L 88,42 Z"/>
            <Path Fill="{StaticResource DotPatternBrush}" Data="M 118,12 L 150,8 L 182,14 L 186,30 L 172,44 L 156,56 L 144,50 L 134,40 L 122,30 Z"/>
            <Path Fill="{StaticResource DotPatternBrush}" Data="M 160,68 L 180,66 L 186,78 L 170,86 L 158,80 Z"/>
            <!-- liaisons -->
            <Path Stroke="#AA4DC3FF" StrokeThickness="0.7" Data="M 40,30 Q 70,-4 104,22"/>
            <Path Stroke="#AA4DC3FF" StrokeThickness="0.7" Data="M 104,22 Q 128,2 156,26"/>
            <Path Stroke="#AA4DC3FF" StrokeThickness="0.7" Data="M 40,30 Q 56,52 56,70"/>
            <Path Stroke="#AA4DC3FF" StrokeThickness="0.7" Data="M 104,22 Q 112,40 104,56"/>
            <Path Stroke="#AAFF6B6B" StrokeThickness="0.7" Data="M 156,26 Q 170,46 170,74"/>
            <!-- noeuds -->
            <Ellipse Canvas.Left="37.5" Canvas.Top="27.5" Width="5" Height="5" Fill="#4DDCFF"><Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="6" ShadowDepth="0"/></Ellipse.Effect></Ellipse>
            <Ellipse Canvas.Left="101.5" Canvas.Top="19.5" Width="5" Height="5" Fill="#4DDCFF"><Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="6" ShadowDepth="0"/></Ellipse.Effect></Ellipse>
            <Ellipse Canvas.Left="53.5" Canvas.Top="67.5" Width="5" Height="5" Fill="#4DDCFF"><Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="6" ShadowDepth="0"/></Ellipse.Effect></Ellipse>
            <Ellipse Canvas.Left="101.5" Canvas.Top="53.5" Width="5" Height="5" Fill="#4DDCFF"><Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="6" ShadowDepth="0"/></Ellipse.Effect></Ellipse>
            <Ellipse Canvas.Left="153.5" Canvas.Top="23.5" Width="5" Height="5" Fill="#4DDCFF"><Ellipse.Effect><DropShadowEffect Color="#4DC3FF" BlurRadius="6" ShadowDepth="0"/></Ellipse.Effect></Ellipse>
            <Ellipse Canvas.Left="167.5" Canvas.Top="71.5" Width="5" Height="5" Fill="#FF6B6B"><Ellipse.Effect><DropShadowEffect Color="#FF3B3B" BlurRadius="8" ShadowDepth="0"/></Ellipse.Effect></Ellipse>
        </Canvas>
    </Viewbox>
</ResourceDictionary>
